{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WinFinder",
  "mainBinaryName": "WinFinder",
  "version": "0.2.0",
  "identifier": "community.finderwin.app",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBN0E2NzMyRUUwMDc5MTAKUldRUWVRRHVNbWQ2V3RDOWZmWWlvWTc0ZWd5SEJpaXNnL3k3Q1VJTWNzYnkrNUpsZkNmL21ka0YK",
      "endpoints": [
        "https://github.com/ctliwork/winfinder/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
